# Consola de administración — variables de entorno
#
# Copia este fichero a `.env.local` (ignorado por git) y ajusta lo que necesites.

# Backend simulado en memoria: la consola funciona entera sin FastAPI detrás.
# Ver `src/api/mock/`. Poner a 1 para desarrollar o ensayar la demo sin backend;
# borrar la línea (o dejarla vacía) para hablar con el backend de verdad.
VITE_MOCK=1

# Base de la API. Vacío = mismo origen, que en desarrollo significa el proxy de
# Vite (`/api` -> VITE_PROXY_TARGET). Solo hay que rellenarlo si el backend vive
# en otro dominio, y entonces habrá que habilitar CORS en FastAPI.
VITE_API_BASE=

# Adónde reenvía el proxy de desarrollo. Lo lee `vite.config.ts`, no el navegador.
VITE_PROXY_TARGET=http://localhost:8000
