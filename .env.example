# ---------------------------------------------------------------------------
# Copiar a .env y rellenar. El .env NO va al repo.
# ---------------------------------------------------------------------------

# --- Base de datos -----------------------------------------------------------
# Puerto 5433 para no chocar con un Postgres local en el 5432.
DATABASE_URL=postgresql://postop:postop@localhost:5433/postop

# --- LLM ---------------------------------------------------------------------
# Único punto de decisión: cambiar LLM_PROVIDER conmuta todo el agente.
# gemini = primario (mejor español, tool calling fiable)
# groq   = plan B de DISPONIBILIDAD, no de latencia. Se creía que ahorraba
#          200-400 ms; medido son 91 ms de TTFT, y en el turno completo con tool
#          calling su free tier da timeouts: 22,5 s de mediana frente a 1,2 s.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voz (local) -------------------------------------------------------------
# VOZ=1 habilita el router de WebSockets /ws/voz y el motor de voz en vivo
VOZ=1
# Fijado por el spike de la Fase 0 (ver README §Presupuesto de latencia):
#   small  + prompt clínico =  481 ms  y transcribe "apendicectomía" bien
#   medium sin prompt       = 1222 ms  para la misma precisión
#   large-v3-turbo          = 1257 ms
# El prompt de sesgo de vocabulario vive en app/voice/stt.py (VOCABULARIO_CLINICO).
STT_MODEL=mlx-community/whisper-small-mlx

# Dos modos de voz. Aquí solo se declara qué motor implementa cada modo; cuál
# está ACTIVO (local | premium) vive en la tabla app_settings y se cambia con
# `PUT /api/settings/voice-mode` (no hay botón en la consola todavía).
#
# HOY ESO NO CAMBIA LA VOZ DE UNA LLAMADA: el modo activo solo lo consulta
# voice_mode.VoiceRouter, y nadie lo construye, así que las dos rutas de voz usan
# TTS_ENGINE_LOCAL fijo. Para cambiar de motor, cambia esta línea y reinicia.
TTS_ENGINE_LOCAL=kokoro        # kokoro | piper | say  — gratis, ilimitado, sin red
TTS_ENGINE_PREMIUM=elevenlabs  # elevenlabs | cartesia — mejor voz, coste por carácter
TTS_VOICE=ef_dora

# Premium. Se deja vacío durante el desarrollo: el free tier de ElevenLabs son
# ~10.000 caracteres/mes y se agota en una tarde de iterar sobre el guion.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# --- RAG (local) -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# El reranker es la mayor palanca de precisión y también el mayor bloque de
# latencia: top-8 cuesta 585 ms medidos contra la API real. El spike de la Fase 0
# publicó 114 ms, pero medía pasajes de 250 caracteres y los reales tienen 500-1400.
#
# NO lo pongas a false para recuperar esos 585 ms: hoy eso deja `hay_evidencia`
# siempre en False y el agente dice «no tengo esa información» con el protocolo
# delante (docs/REVISION_F2_F3.md §1.12). Encenderlo o no es además una decisión
# abierta, a cerrar con eval/medir_reranker.py sobre el corpus real.
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVE_TOP_K=8           # candidatos que entran al reranker
CONTEXT_TOP_K=4            # chunks que llegan al LLM

# Umbral por debajo del cual el agente responde "no tengo esa información"
# en vez de improvisar. Grounding obligatorio.
MIN_RELEVANCE_SCORE=0.35

# --- Almacenamiento ----------------------------------------------------------
STORAGE_DIR=./storage/documents

# --- Consola de administración y Frontend ------------------------------------
ADMIN_TOKEN=cambiar-esto-en-local
VITE_WS_BASE=ws://localhost:8000
